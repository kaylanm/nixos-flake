#!/usr/bin/env python3
"""Encrypt legacy secret files without writing plaintext to disk."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

RESTIC = {
    "restic-environment": "etc/restic-env",
    "restic-password": "etc/restic-password",
    "restic-repository": "etc/restic-repository",
}
SOURCES = {
    "optiplex1": {
        "acme-environment": "etc/acme-env",
        "linkwarden-nextauth-secret": "etc/nextauth-secret",
        "mosquitto-password-hash": "etc/mosquitto/passwd",
        "nut-password": "etc/nut-passwd",
        **RESTIC,
        "zigbee2mqtt-secrets": "etc/zigbee2mqtt/secret.yaml",
    },
    "optiplex2": RESTIC,
    "optiplex3": {
        "buzz-environment": "etc/buzz/secrets.env",
        "hermes-environment": "etc/hermes/secrets.env",
        "github-app-private-key": "etc/hermes/kaylanm-hermes-agent.2026-10-25.private-key.pem",
    },
}


def migrate(host, repo_dir, source_root=Path("/")):
    output = repo_dir / "secrets" / f"{host}.yaml"
    if output.exists() or output.is_symlink():
        raise FileExistsError(f"refusing to overwrite existing file: {output}")
    # Decode strictly and disable newline translation: file payloads must survive
    # round-tripping exactly, including trailing newlines and CRLF.
    payload = {
        key: (source_root / source).read_bytes().decode("utf-8")
        for key, source in SOURCES[host].items()
    }
    encrypted = subprocess.run(
        [
            "sops", "--encrypt", "--config", str(repo_dir / ".sops.yaml"),
            "--filename-override", f"secrets/{host}.yaml",
            "--input-type", "json", "--output-type", "yaml", "/dev/stdin",
        ],
        cwd=repo_dir,
        input=json.dumps(payload).encode("utf-8"),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    ).stdout
    output.parent.mkdir(parents=True, exist_ok=True)
    # Exclusive creation also prevents a concurrent migration or symlink from
    # replacing a previously encrypted file. Only ciphertext reaches disk.
    with output.open("xb") as stream:
        stream.write(encrypted)
        # Ciphertext is safe to commit; keep it readable by the checkout owner.
        os.fchmod(stream.fileno(), 0o644)
    return output


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("host", choices=SOURCES)
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("run as root to read the existing secret files")
    os.umask(0o077)
    try:
        output = migrate(args.host, Path(__file__).resolve().parent.parent)
    except subprocess.CalledProcessError:
        # Do not echo input or tool diagnostics that could contain secret data.
        print("SOPS encryption failed; no output file created", file=sys.stderr)
        return 1
    except (OSError, UnicodeError) as error:
        print(f"migration failed: {type(error).__name__}; check source files and output permissions", file=sys.stderr)
        return 1
    print(f"created {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
