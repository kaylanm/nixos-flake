#!/usr/bin/env bash

set -euo pipefail
umask 077

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this script as root so it can read the existing secret files." >&2
  exit 1
fi

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <optiplex1|optiplex2>" >&2
  exit 1
fi

host=$1
script_dir=$(dirname -- "$(readlink -f -- "$0")")
repo_dir=$(dirname -- "$script_dir")
output_file="$repo_dir/secrets/$host.yaml"

case "$host" in
  optiplex1)
    keys=(
      acme-environment
      linkwarden-nextauth-secret
      mosquitto-password-hash
      nut-password
      restic-environment
      restic-password
      restic-repository
      zigbee2mqtt-secrets
    )
    sources=(
      /etc/acme-env
      /etc/nextauth-secret
      /etc/mosquitto/passwd
      /etc/nut-passwd
      /etc/restic-env
      /etc/restic-password
      /etc/restic-repository
      /etc/zigbee2mqtt/secret.yaml
    )
    ;;
  optiplex2)
    keys=(
      restic-environment
      restic-password
      restic-repository
    )
    sources=(
      /etc/restic-env
      /etc/restic-password
      /etc/restic-repository
    )
    ;;
  *)
    echo "unsupported host: $host" >&2
    exit 1
    ;;
esac

for source_file in "${sources[@]}"; do
  if [[ ! -f $source_file || ! -r $source_file ]]; then
    echo "cannot read required secret file: $source_file" >&2
    exit 1
  fi
done

if [[ -e $output_file ]]; then
  echo "refusing to overwrite existing file: $output_file" >&2
  exit 1
fi

work_dir=$(mktemp -d /tmp/nixos-flake-secrets.XXXXXXXXXX)
plaintext_file="$work_dir/plaintext.yaml"
encrypted_file="$work_dir/encrypted.yaml"

cleanup() {
  rm -f -- "$plaintext_file" "$encrypted_file"
  rmdir -- "$work_dir"
}
trap cleanup EXIT

for index in "${!keys[@]}"; do
  printf '%s: |-\n' "${keys[$index]}" >> "$plaintext_file"
  sed 's/^/  /' "${sources[$index]}" >> "$plaintext_file"
  printf '\n' >> "$plaintext_file"
done

mkdir -p -- "$repo_dir/secrets"
sops \
  --encrypt \
  --config "$repo_dir/.sops.yaml" \
  --filename-override "secrets/$host.yaml" \
  --output "$encrypted_file" \
  "$plaintext_file"
install -m 0644 -- "$encrypted_file" "$output_file"

if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
  chown -- "$SUDO_USER" "$output_file"
fi

echo "created $output_file"
